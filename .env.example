# ==============================================================================
# Chatze Nepal Edition - Zero-Setup Environment Configuration
# ==============================================================================
# ON CLOUDFLARE: ZERO SETUP REQUIRED!
# When deployed to Cloudflare via wrangler.jsonc or the 1-Click Deploy button,
# Cloudflare D1 Native Database (5 GB SQLite at Edge) and WebCrypto Asymmetric
# Keys are automatically provisioned. You do NOT need Neon, Vercel, or Redis.
# ==============================================================================

# Better Auth Secret (Auto-generated on Cloudflare, or provide random 32+ char string)
BETTER_AUTH_SECRET=chatze-edge-production-secret-key-np-2026

# Optional: Public Application URL (defaults to request origin)
PUBLIC_APP_URL=https://chatze-nepal.workers.dev

# Optional: Standalone PostgreSQL connection (ONLY if NOT using Cloudflare D1)
# If unset, the app uses Cloudflare D1 or in-memory edge SQLite store automatically.
# DATABASE_URL=postgresql://user:password@localhost:5432/chatze

# Web Push VAPID Security Credentials (Stored in .env / Cloudflare Worker Secrets)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BAV9SIwwOf2vhDMwhjs0H9To0hiJvc-BDRl1E3ZxV4p35Ykdw74vCo_Bpp1GfRAEnG2oQyD8vqH_dVywN0QHXZM
